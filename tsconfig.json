{
  "compilerOptions": {
    /* 基本选项 */
    "target": "es2017",
    "module": "commonjs",
    "lib": [
      "es6"
    ],
    "outDir": "./dist/",
    "rootDir": "./",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    
    /* 路径别名配置 */
    "paths": {
      "@util": ["./util/index.ts"],
      "@request": ["./util/request.ts"]
    },

    /* 【新增】关闭隐式 any 类型检查，解决 TS7006 报错 */
    "noImplicitAny": false
  },
  "exclude": [
    "node_modules",
    "node_modules/cheerio/lib"
  ]
}
